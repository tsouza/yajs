{
  "name": "yajson-stream",
  "version": "2.0.0-beta.1",
  "description": "Yet Another JSON Streaming Tool",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "antlr": "antlr4ts -visitor -no-listener src/main/lib/path/parser/YAJS.g4",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsouza/yajs.git"
  },
  "keywords": [
    "json",
    "stream"
  ],
  "author": "Thiago Souza <tcostasouza@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tsouza/yajs/issues"
  },
  "main": "dist/main/main.js",
  "types": "dist/main/yajs.d.ts",
  "module": "dist/main/yajs.js",
  "bin": {
    "yajs": "dist/main/index.js"
  },
  "homepage": "https://github.com/tsouza/yajs#readme",
  "dependencies": {
    "antlr4ts": "^0.4.1-alpha.0",
    "lodash": "4.18.1",
    "through": "^2.3.8"
  },
  "devDependencies": {
    "@types/jsonpath": "^0.2.0",
    "@types/lodash": "4.17.25",
    "@types/node": "^22.10.0",
    "@types/through": "0.0.33",
    "@vitest/coverage-v8": "^4.1.11",
    "antlr4ts-cli": "^0.4.0-alpha.4",
    "ascii-table": "0.0.9",
    "eslint": "^9.39.5",
    "fast-check": "^4.9.0",
    "fast-stats": "0.0.3",
    "humanize-duration": "^3.12.1",
    "JSONStream": "^1.3.2",
    "measured": "^1.1.0",
    "oboe": "^2.1.4",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
