{
  "compilerOptions": {
    /* Language & Environment */
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "allowJs": true,

    /* Emit */
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",

    /* Strictness (pragmatic: catch real bugs, no full-repo rewrite) */
    "strict": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    // The infinite-loop fix in JsonSaxParser.ts (charError -> a terminal
    // ERROR state, with an explicit `continue` at every charError call
    // site) removed the switch-case fallthrough this codebase used to rely
    // on for error handling. Verified clean with this flag on.
    "noFallthroughCasesInSwitch": true,

    /* Interop / correctness */
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    "typeRoots": ["node_modules/@types"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/main/**/*.js"
  ],
  "exclude": [
    "src/bench",
    "src/test",
    "dist",
    "node_modules"
  ]
}
